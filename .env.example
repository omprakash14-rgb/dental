# =============================================================================
# DentalAI — Production Environment Template
# Duplicate this file to '.env' and populate with secure institutional credentials.
# =============================================================================

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=dentalai
POSTGRES_USER=dentalai
POSTGRES_PASSWORD=generate_a_very_secure_password_here_12345
DATABASE_URL=postgresql+psycopg2://dentalai:generate_a_very_secure_password_here_12345@localhost:5432/dentalai

# Backend API Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Security & Authentication (JWT + Bcrypt)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_random_cryptographic_hex_key_at_least_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Traffic Rate Limiting (SlowAPI)
RATE_LIMIT_PER_MINUTE=60

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost,https://dentalai.your-clinic.org

# AI Pretrained Model Paths (Pretrained ResNet-50)
MODEL_PATH=models/best_model_resnet50.keras
CLASS_INDICES_PATH=models/class_indices.json
UPLOAD_DIR=uploads
REPORTS_DIR=reports

# Frontend Client Configuration
VITE_API_URL=http://localhost:8000
